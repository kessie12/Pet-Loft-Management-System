{
  "name": "mellow-pet-loft",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "check:server": "tsc -p tsconfig.server.json",
    "dev:demo": "vite --mode demo",
    "dev:cloud": "npm run build && wrangler pages dev dist",
    "db:migrate:local": "wrangler d1 migrations apply mellow_pet_loft_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply mellow_pet_loft_db --remote",
    "build:functions": "wrangler pages functions build --outdir .wrangler/functions-build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "esbuild": "0.28.2",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "miniflare": "5.20261006.1-alpha",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
