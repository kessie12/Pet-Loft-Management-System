{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "noEmit": true, "skipLibCheck": true, "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["server", "functions", "src/lib", "src/types", "src/data", "src/vite-env.d.ts"]
}
